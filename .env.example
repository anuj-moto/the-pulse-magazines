# ─────────────────────────────────────────────────────────────
# The Pulse Magazines — environment variables
# Copy this file to `.env` and fill in real values.
# ─────────────────────────────────────────────────────────────

# --- Core ---------------------------------------------------------------
# SQLite database file. Local dev keeps it in the project root.
# On the production VPS use an absolute path, e.g. file:/var/www/pulse/pulse.db
DATABASE_URI=file:./pulse.db

# Long random string used to sign Payload tokens.
# Generate one with:  openssl rand -hex 32
PAYLOAD_SECRET=

# Public base URL of the site. Used for SEO canonical URLs, sitemap,
# RSS feed and absolute links. No trailing slash.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Email (contact form notifications) ---------------------------------
# SMTP credentials. In production use a Hostinger mailbox, e.g.
# noreply@thepulsemagazines.com via smtp.hostinger.com:465.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Address contact-form submissions are emailed to (the site owner's inbox).
CONTACT_NOTIFY_EMAIL=

# --- WordPress migration (one-time, used by `pnpm migrate:wp`) -----------
# Source WordPress site to import all existing content from.
WORDPRESS_API_URL=https://thepulsemagazines.com

# --- Market ticker (optional) -------------------------------------------
# Grab a free key at https://finnhub.io/register — it takes 30 seconds.
# Without it the ticker silently falls back to crypto-only (CoinGecko,
# which needs no key).
FINNHUB_API_KEY=
